{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all",
    "schedule:daily"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchDepNames": [
        "org.easytesting:fest-util"
      ],
      "allowedVersions": "<1.2.0"
    },
    {
      "matchDepNames": [
        "com.google.errorprone:error_prone_core"
      ],
      "description": "Error Prone historically shipped broken releases (e.g. 2.47.0 crashed on JDK 21), so require a green build before updating",
      "automerge": false
    }
  ],
  "schedule": [
    "at any time"
  ]
}
